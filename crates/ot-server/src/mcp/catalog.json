        "additionalProperties": false
       },
       {
        "type": "object",
        "properties": {
         "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "A UUID for this posting request. Reuse the same UUID on a retry."
         },
         "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "reference": {
          "type": "string",
          "maxLength": 100
         },
         "narration": {
          "type": "string",
          "maxLength": 500
         },
         "kind": {
          "type": "string",
          "enum": [
           "payment",
           "receipt",
           "journal",
           "contra"
          ]
         },
         "postings": {
          "minItems": 2,
          "maxItems": 50,
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "ledger_id": {
             "type": "integer",
             "exclusiveMinimum": 0,
             "maximum": 9007199254740991
            },
            "side": {
             "type": "string",
             "enum": [
              "debit",
              "credit"
             ]
            },
            "amount": {
             "type": "string",
             "pattern": "^\\d{1,18}(?:\\.\\d{1,2})?$",
