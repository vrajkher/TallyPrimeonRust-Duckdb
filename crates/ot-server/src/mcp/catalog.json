          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
         },
         "amount": {
          "type": "string",
          "pattern": "^\\d{1,18}(?:\\.\\d{1,2})?$"
         }
        },
        "required": [
