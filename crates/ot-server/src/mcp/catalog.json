             "maxItems": 100,
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
               },
               "centre": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
